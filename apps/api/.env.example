# Local development with docker compose
DATABASE_URL=postgresql://cordillera:cordillera_dev@localhost:5432/cordillera
PORT=3000
# Lifetime of the customer session cookie.
SESSION_TTL_DAYS=30
# Minimum length accepted when registering an account.
PASSWORD_MIN_LENGTH=8
# Longest data URL accepted for a profile picture.
AVATAR_MAX_CHARACTERS=200000
# Country the store ships to; addresses take it when the form does not ask for it.
STORE_COUNTRY=CO
# Whether the session cookie carries the Secure flag. Leave unset to default to
# production behaviour; set to false when serving over plain HTTP (e.g. the local
# container group), true behind HTTPS.
# SESSION_COOKIE_SECURE=false
