# Port the middleware listens on.
PORT=8000
# Base URL of the Fastify API this middleware forwards to.
# In docker compose the API runs on the host, reachable via host.docker.internal.
API_BASE_URL=http://host.docker.internal:3000
# MercadoPago credentials. Placeholders until the payment integration lands.
# Get real values from the MercadoPago developer dashboard.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
